NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# Clerk (admin auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# Supabase secret key — bypasses RLS, admin writes only.
# Server-only: never import this in a "use client" file.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Optional: GitHub token (fine-grained, public-repo read-only). Raises the
# GitHub API rate limit for the "Store data last synced" date.
# GITHUB_TOKEN=
